# Prompt Eval LLM config
# Fill ONE api key field below
OPENAI_API_KEY=
# LLM_API_KEY=
DASHSCOPE_API_KEY=

# Optional endpoint/model settings
# OPENAI_BASE_URL=https://your-gateway/v1
LLM_BASE_URL=https://api-llm.yupaowang.com/v1/chat/completions
# DASHSCOPE_BASE_URL=
LLM_MODEL=qwen3-max

# Optional runtime tuning
LLM_TIMEOUT_SEC=30
LLM_MAX_RETRY=2

# optional feishu webhook
FEISHU_WEBHOOK=

# ===== 飞书企业登录 =====
FEISHU_AUTH_ENABLED=false
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_REDIRECT_URI=http://127.0.0.1:8000/api/auth/callback
FEISHU_SESSION_SECRET=
FRONTEND_BASE_URL=http://127.0.0.1:3000
# 多个值用逗号分隔；留空表示允许所有已登录用户访问
FEISHU_ALLOWED_OPEN_IDS=
FEISHU_ALLOWED_EMAILS=
# 多个值用逗号分隔；留空表示默认把当前已登录账号视为管理员
FEISHU_ADMIN_OPEN_IDS=
FEISHU_ADMIN_EMAILS=

# ===== ODPS (MaxCompute) 连接配置 =====
ODPS_ACCESS_KEY_ID=
ODPS_ACCESS_KEY_SECRET=
ODPS_PROJECT=yuapo_dev
ODPS_ENDPOINT=http://service.cn.maxcompute.aliyun-inc.com/api
